# ==============================================================================
# GarageFlow - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR LOCAL CONFIGURATION VALUES.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask & Security Configuration
# ------------------------------------------------------------------------------
FLASK_ENV=production
FLASK_APP=app:create_app
FLASK_RUN_PORT=5000
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=86400

# ------------------------------------------------------------------------------
# Database Configuration (Docker Compose & Local PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=garageflow_app
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=garageflow_db

# Local Native Connection URL (host mode)
# Format: postgresql+psycopg2://<user>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql+psycopg2://garageflow_app:your_secure_postgres_password@localhost:5432/garageflow_db

# Test Database Connection (MUST be isolated from the live garageflow_db)
TEST_DATABASE_URL=postgresql+psycopg2://garageflow_app:your_secure_postgres_password@localhost:5432/garageflow_test_db

# ------------------------------------------------------------------------------
# Docker Compose Port Bindings (Prevent Conflicts with Host Services)
# ------------------------------------------------------------------------------
# Frontend exposed port (default 8080 to avoid conflict with host port 80)
FRONTEND_PORT=8080

# PostgreSQL Docker exposed port on host (default 5433 to avoid conflict with native PostgreSQL 5432)
DB_HOST_PORT=5433

# ------------------------------------------------------------------------------
# Application Parameters
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOW_STOCK_THRESHOLD=5
