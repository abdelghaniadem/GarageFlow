# ==============================================================================
# GarageFlow - Kubernetes Backend Secret Configuration Template
# COPY THIS FILE TO 'backend-secret.env' IN THIS DIRECTORY AND FILL IN CREDENTIALS.
# NEVER COMMIT 'backend-secret.env' TO VERSION CONTROL.
# ==============================================================================

# Database Connection URL pointing to internal Kubernetes Service 'garageflow-db:5432'
# Format: postgresql+psycopg2://<POSTGRES_USER>:<POSTGRES_PASSWORD>@garageflow-db:5432/<POSTGRES_DB>
DATABASE_URL=postgresql+psycopg2://garageflow_app:your_secure_postgres_password_here@garageflow-db:5432/garageflow_db

# Flask session security key (minimum 32 random characters)
SECRET_KEY=generate_a_secure_random_flask_secret_key_here

# JWT authentication signing key (minimum 32 random characters)
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key_here
