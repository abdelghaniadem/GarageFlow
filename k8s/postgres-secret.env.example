# ==============================================================================
# GarageFlow - Kubernetes PostgreSQL Secret Template
# COPY THIS FILE TO 'postgres-secret.env' IN THIS DIRECTORY AND FILL IN CREDENTIALS.
# NEVER COMMIT 'postgres-secret.env' TO VERSION CONTROL.
# ==============================================================================

POSTGRES_DB=garageflow_db
POSTGRES_USER=garageflow_app
POSTGRES_PASSWORD=your_secure_postgres_password_here
