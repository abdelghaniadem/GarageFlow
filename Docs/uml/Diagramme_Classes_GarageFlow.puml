@startuml
skinparam classAttributeIconSize 0
left to right direction

class Utilisateur {
  - id_utilisateur : Integer
  - nom : String
  - prenom : String
  - email : String
  - mot_de_passe : String
  - role : String
  - telephone : String
  + seConnecter()
  + seDeconnecter()
  + modifierProfil()
}

class Mecanicien {
  - id_mecanicien : Integer
  - specialite : String
  - id_utilisateur : Integer
  + consulterReparations()
  + enregistrerDiagnostic()
  + modifierStatut()
}

class Client {
  - id_client : Integer
  - nom : String
  - prenom : String
  - adresse : String
  - telephone : String
  + ajouterClient()
  + modifierClient()
  + supprimerClient()
}

class Vehicule {
  - id_vehicule : Integer
  - marque : String
  - modele : String
  - immatriculation : String
  - annee : Integer
  - kilometrage : Integer
  - etat : String
  + ajouterVehicule()
  + modifierVehicule()
}

class Reparation {
  - id_reparation : Integer
  - description : String
  - date_reparation : Date
  - diagnostic : Text
  - travail_effectue : Text
  - statut : String
  - cout : Decimal
  - kilometrage : Integer
  + creerReparation()
  + enregistrerDiagnostic()
  + changerStatut()
  + calculerCout()
}

class PieceDetachee {
  - id_piece : Integer
  - nom : String
  - prix_unitaire : Decimal
  - quantite_stock : Integer
  + ajouterPiece()
  + modifierStock()
}

class ReparationPiece {
  - id_reparation : Integer PK, FK
  - id_piece : Integer PK, FK
  - quantite : Integer
  - prix_unitaire : Decimal
}

class Facture {
  - id_facture : Integer
  - date_facture : Date
  - montant_total : Decimal
  - statut_paiement : String
  + creerFacture()
  + calculerMontant()
}

class RendezVous {
  - id_rendezvous : Integer
  - date_rendezvous : Date
  - heure : Time
  - motif : String
  - statut : String
}

Utilisateur "1" -- "0..1" Mecanicien

Client "1" -- "0..*" Vehicule
Vehicule "1" -- "0..*" Reparation
Mecanicien "1" -- "0..*" Reparation

Reparation "1" -- "0..*" ReparationPiece
PieceDetachee "1" -- "0..*" ReparationPiece

Reparation "1" -- "1" Facture

Client "1" -- "0..*" RendezVous
Vehicule "1" -- "0..*" RendezVous
@enduml
